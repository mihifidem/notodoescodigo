# Django
SECRET_KEY=your-very-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL for production)
DATABASE_URL=postgres://user:password@localhost:5432/mihi_training

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0

# DuckyClash: empty fails closed outside development.
# Development defaults to LocalPointsBankGateway (real User.puntos, not an external API).
# To explicitly select local points in another environment:
# DUCKYCLASH_PAYMENT_GATEWAY=apps.duckyclash.local_bank.LocalPointsBankGateway
DUCKYCLASH_PAYMENT_GATEWAY=
DUCKYCLASH_BANK_GATEWAY=
DUCKYCLASH_KNOWLEDGE_GATEWAY=apps.duckyclash.knowledge.LMSKnowledgeGateway
DUCKYCLASH_ECOMOTOR_GATEWAY=
DUCKYCLASH_DOUBLE_KO=draw
DUCKYCLASH_MAX_TIEBREAKS=1

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your@email.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=MihiTraining <no-reply@mihitraining.com>

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key

# Google OAuth (django-allauth)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Site
SITE_URL=http://localhost:8000
SITE_NAME=MihiTraining
